<?xml version="1.0"?>
<launch>
    <!--
        RoboPong top-level launch.
        hardware.launch already brings up the UR5e driver, MoveIt (/move_group),
        the camera, robot_state_publisher, joint_state_publisher, and RViz.
        Do not duplicate any of that here.
    -->
    <arg name="sim" default="false" />

    <include unless="$(arg sim)" file="$(find cu_ur5e_bringup)/launch/hardware.launch">
        <arg name="rviz" value="false" />
    </include>
    <include if="$(arg sim)" file="$(find cu_ur5e_moveit_config)/launch/demo.launch" />

    <param name="robot_description" command="xacro $(dirname)/../robots/basic_setup.urdf.xacro" />

    <node pkg="rviz" type="rviz" name="$(anon rviz)" args="-d $(dirname)/../config/robopong.rviz" />

    <!-- ===== RoboPong nodes (add as each phase lands) ===== -->

    <!-- Phase 2: vision -->
    <arg name="z_height"     default="0.72" />    <!-- table surface Z in base frame (TF: base -> table_top.z = 0.720) -->

    <node pkg="robopong" type="vision_node.py" name="vision_node" output="screen">
        <param name="camera_topic" value="/cam/color/image_raw" />
        <param name="z_height"     value="$(arg z_height)" />
    </node>

    <!-- Phase 3: motion (MoveIt wind-up + Ruckig 3-DoF throw swing)
         velocity/acceleration scaling are MoveIt's planning-stage limits used
         for the slow wind-up to aimed_ready. The throw itself is a Ruckig
         time-synchronised 3-DoF plan on shoulder_lift + elbow + wrist_1,
         executed via moveit_commander; the controller's hold at the launch
         pose (with non-zero release velocities) brakes the arm abruptly and
         releases the ball. Pan + wrist_2/3 are held constant. -->
    <arg name="move_group"           default="arm" />
    <arg name="velocity_scaling"     default="1.0" />
    <arg name="acceleration_scaling" default="1.0" />

    <!-- Per-joint release velocities (rad/s, signed). Sign follows pose A→B:
         lift   decreasing -> negative
         elbow  decreasing -> negative
         wrist1 increasing -> positive (snaps the scoop into the arc) -->
    <arg name="release_velocity_lift"   default="-2.5" />
    <arg name="release_velocity_elbow"  default="-3.5" />
    <arg name="release_velocity_wrist1" default="1.0"  />

    <!-- Per-joint Ruckig kinematic limits -->
    <arg name="max_velocity_lift"     default="3.0"  />
    <arg name="max_velocity_elbow"    default="4.0"  />
    <arg name="max_velocity_wrist1"   default="6.0"  />
    <arg name="max_acceleration_lift"   default="20.0" />
    <arg name="max_acceleration_elbow"  default="20.0" />
    <arg name="max_acceleration_wrist1" default="25.0" />
    <arg name="max_jerk_lift"   default="60.0"  />
    <arg name="max_jerk_elbow"  default="60.0"  />
    <arg name="max_jerk_wrist1" default="120.0" />

    <arg name="control_cycle"        default="0.008" />  <!-- s, Ruckig sample period -->

    <node pkg="robopong" type="motion_node.py" name="motion_node" output="screen">
        <param name="move_group"            value="$(arg move_group)" />
        <param name="velocity_scaling"      value="$(arg velocity_scaling)" />
        <param name="acceleration_scaling"  value="$(arg acceleration_scaling)" />

        <param name="release_velocity_lift"   value="$(arg release_velocity_lift)"   />
        <param name="release_velocity_elbow"  value="$(arg release_velocity_elbow)"  />
        <param name="release_velocity_wrist1" value="$(arg release_velocity_wrist1)" />

        <param name="max_velocity_lift"     value="$(arg max_velocity_lift)"     />
        <param name="max_velocity_elbow"    value="$(arg max_velocity_elbow)"    />
        <param name="max_velocity_wrist1"   value="$(arg max_velocity_wrist1)"   />
        <param name="max_acceleration_lift"   value="$(arg max_acceleration_lift)"   />
        <param name="max_acceleration_elbow"  value="$(arg max_acceleration_elbow)"  />
        <param name="max_acceleration_wrist1" value="$(arg max_acceleration_wrist1)" />
        <param name="max_jerk_lift"   value="$(arg max_jerk_lift)"   />
        <param name="max_jerk_elbow"  value="$(arg max_jerk_elbow)"  />
        <param name="max_jerk_wrist1" value="$(arg max_jerk_wrist1)" />

        <param name="control_cycle"         value="$(arg control_cycle)" />
    </node>

    <!-- Phase 4: game orchestration (state machine) -->
    <!-- <node pkg="robopong" type="game_node.py" name="game_node" output="screen" /> -->

</launch>
